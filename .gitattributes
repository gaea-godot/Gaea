/**        export-ignore
/addons    !export-ignore
/addons/** !export-ignore
/addons/gdscript_formatter export-ignore
/addons/gdscript_formatter/** export-ignore
/addons/gdUnit4/ export-ignore
/addons/gdUnit4/** export-ignore
